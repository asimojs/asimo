{
    "name": "@asimojs/asimo",
    "version": "6.0.0",
    "description": "Type-safe asynchronous IoC for browser and server runtimes",
    "main": "dist/asimo.js",
    "types": "dist/asimo.d.ts",
    "typings": "dist/asimo.d.ts",
    "type": "module",
    "files": [
        "dist"
    ],
    "author": "Bertrand Laporte",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/asimojs/asimo.git"
    },
    "bugs": "https://github.com/asimojs/asimo/issues",
    "homepage": "https://github.com/asimojs/asimo",
    "keywords": [
        "dependency inversion",
        "dependency injection",
        "DI",
        "IoC",
        "test",
        "React context",
        "progressive load",
        "dynamic import",
        "application packaging",
        "module",
        "module loader",
        "lazy package manager"
    ],
    "scripts": {
        "clean": "rimraf dist lib",
        "build": "pnpm clean && vite build && tsc --emitDeclarationOnly && cp -R lib/*.d.ts dist",
        "test:watch": "vitest",
        "test": "vitest run",
        "coverage": "vitest run --coverage --coverage.extension=.ts",
        "lint": "eslint 'src/**/*.ts'",
        "lint:fix": "eslint 'src/**/*.ts' --fix",
        "prepublishOnly": "pnpm lint && pnpm build && vitest run && npm pack --dry-run",
        "pretty": "prettier --check .",
        "pretty:fix": "prettier --write .",
        "docs:dev": "astro dev",
        "docs:build": "astro build",
        "docs:preview": "astro preview"
    },
    "devDependencies": {
        "@astrojs/sitemap": "^3.4.0",
        "@astrojs/starlight": "~0.29.3",
        "@eslint/js": "^10.0.1",
        "@rolldown/binding-darwin-arm64": "1.1.5",
        "@vitest/coverage-v8": "4.1.10",
        "astro": "^4.16.19",
        "eslint": "^10.7.0",
        "rimraf": "6.1.3",
        "typescript": "6.0.3",
        "typescript-eslint": "8.64.0",
        "vite": "8.1.4",
        "vitest": "4.1.10"
    },
    "packageManager": "pnpm@10.13.1",
    "pnpm": {
        "overrides": {
            "@astrojs/sitemap": "3.4.0"
        }
    }
}
