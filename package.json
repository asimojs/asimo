{
    "name": "@asimojs/asimo",
    "version": "0.0.0",
    "description": "Asynchronous IoC for the browser",
    "main": "dist/asimo.js",
    "types": "dist/asimo.d.ts",
    "typings": "dist/asimo.d.ts",
    "type": "module",
    "files": [
        "src",
        "dist"
    ],
    "author": "Bertrand Laporte",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/asimojs/asimo.git"
    },
    "bugs": "https://github.com/asimojs/asimo/issues",
    "homepage": "https://github.com/asimojs/asimo",
    "keywords": [
        "dependency inversion",
        "dependency injection",
        "DI",
        "IoC",
        "test",
        "React context",
        "progressive load",
        "dynamic import",
        "application packaging",
        "module",
        "module loader",
        "lazy package manager"
    ],
    "scripts": {
        "clean": "rimraf dist lib",
        "build": "pnpm clean && tsc && vite build && cp -R lib/*.d.ts dist",
        "test:watch": "vitest",
        "test": "vitest run",
        "coverage": "vitest run --coverage --coverage.extension=.ts",
        "prepublish": "pnpm build && vitest run"
    },
    "devDependencies": {
        "@vitest/coverage-v8": "4.1.10",
        "rimraf": "6.1.3",
        "typescript": "7.0.2",
        "vite": "8.1.4",
        "vitest": "4.1.10"
    },
    "packageManager": "pnpm@10.13.1"
}
