{
  "compilerOptions": {
    "declaration": true,
    "rootDir": "src",
    "outDir": "lib",
    "esModuleInterop": true,
    "target": "es6",
    "module": "es6",
    "moduleResolution": "bundler",
    "strict": true,
    "removeComments": false,
    "preserveConstEnums": true,
    "lib": [
      "ESNext",
      "DOM"
  ]
  },
  "exclude": [
    "old",
    "node_modules",
    "**/*.spec.ts",
    "**/test",
    "**/mock"
  ],
  "include": [
    "src/**/*"
  ]
}
